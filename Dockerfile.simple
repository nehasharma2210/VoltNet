# Simple single-service Docker for Render
FROM python:3.10-slim

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy and install backend requirements
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ .

# Copy frontend files to serve as static
COPY frontend/ ./static/

# Verify app exists
RUN test -f /app/app.py || (echo "ERROR: app.py not found!" && exit 1)

# Environment
ENV PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:$PORT/health || exit 1

EXPOSE $PORT

# Simple start command - just backend
CMD python -m uvicorn app:app --host 0.0.0.0 --port $PORT --workers 1